# Copy to .env. Enter secrets locally, never in chat.
# Only the backend reads these. Never use a VITE_ prefix for secrets.
GROQ_API_KEY=
GEMINI_API_KEY=
# Primary candidate: Groq (groq.com), not xAI Grok.
# Actual model availability and account quotas must pass a live probe.
FINN_LLM_PROVIDER=groq
FINN_LLM_MODEL=openai/gpt-oss-120b

# Neon Free pooled PostgreSQL URL. Server only. No VITE_ secret variables.
FINN_DATABASE_URL=
# Optional delivery channel; leave empty to use FINN without Telegram.
FINN_TELEGRAM_BOT_TOKEN=

